# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://tslovjdrcbnewcajawiq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Public form base URL — this is what gets baked into QR codes, embed
# snippets, and copied form links (lib/site-url.ts). It deliberately does
# NOT default to whatever domain you're currently viewing the app from,
# so a QR code printed on a poster keeps working even when tested from a
# preview deployment. Only set this if you configure a custom domain —
# otherwise it defaults to the stable production Vercel domain.
# NEXT_PUBLIC_SITE_URL=https://mmela-sales-hub.vercel.app

# Self-hosted Ollama server for AI policy-document extraction
# (see docs for how to stand this server up)
OLLAMA_API_URL=https://your-ollama-server.example.com
OLLAMA_API_KEY=a_shared_secret_you_set_on_the_reverse_proxy
OLLAMA_MODEL=qwen2.5:7b
